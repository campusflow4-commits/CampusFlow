# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details:
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/skillswap?retryWrites=true&w=majority

# JWT Secret for authentication (you can change this to any random text)
JWT_SECRET=skillswap_super_secret_jwt_key_2026

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
